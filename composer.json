{
    "name": "zwernemann/magento2-chat",
    "description": "AI Chat for Magento 2 – free, open-source conversational AI assistant for the storefront (RAG product search + Anthropic Claude)",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "1.0.0",
    "require": {
        "php": ">=8.1",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-customer": "*",
        "magento/module-sales": "*",
        "magento/module-quote": "*",
        "magento/module-configurable-product": "*",
        "magento/module-backend": "*"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Zwernemann\\Chat\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zwernemann\\Chat\\Test\\": "Test/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
