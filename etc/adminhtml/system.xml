<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="zwernemann" translate="label" sortOrder="300">
            <label>Zwernemann</label>
        </tab>

        <section id="zwernemann_chat" translate="label" sortOrder="100"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Chat</label>
            <tab>zwernemann</tab>
            <resource>Zwernemann_Chat::conversations</resource>

            <!-- General -->
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Chat</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <!-- IMAP -->

            <!-- SMTP -->

            <!-- LLM Provider + universeller System-Prompt -->
            <group id="llm" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AI Language Model (LLM)</label>
                <field id="provider" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Active Provider</label>
                    <source_model>Zwernemann\Chat\Model\Config\Source\LlmProvider</source_model>
                    <comment>AI language model that powers the chat. The free module includes Anthropic Claude; the premium module adds Mistral AI (GDPR / EU) and Google Gemini.</comment>
                </field>
                <field id="address_form" translate="label" type="select" sortOrder="16" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Form of Address</label>
                    <source_model>Zwernemann\Chat\Model\Config\Source\AddressForm</source_model>
                    <comment>Determines whether the assistant addresses the customer formally (Sie) or casually (Du). Affects the salutation and sign-off of all e-mails.</comment>
                </field>
                <field id="shop_name" translate="label" type="text" sortOrder="17" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Shop Name (Signature)</label>
                    <comment>Name the assistant uses to sign off (e.g. "Your team at Example Ltd."). Leave empty to use the "From Name" from the SMTP settings.</comment>
                </field>
                <field id="system_prompt_base" translate="label" type="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>System Prompt (Default, fixed)</label>
                    <frontend_model>Zwernemann\Chat\Block\Adminhtml\System\Config\BasePromptInfo</frontend_model>
                    <comment>The built-in default prompt. Not editable – for reference only.</comment>
                </field>
                <field id="system_prompt_additions" translate="label" type="textarea" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>System Prompt Additions</label>
                    <comment>Optional additional instructions appended to the default prompt. Leave empty for the default prompt only. Changes take effect immediately.</comment>
                </field>
                <field id="history_turns_main" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>History Turns (Main Model)</label>
                    <comment>Number of recent conversation rounds (user + assistant = 1 turn each) passed to the main model as multi-turn context. More turns = more context but higher cost. Default: 4</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="history_turns_account" translate="label" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>History Turns (Account / Order Queries)</label>
                    <comment>Number of history turns for address, order, cart and account queries (no product RAG needed). Lower than the main-model turns to save tokens. Default: 2</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="history_turns_query" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>History Messages (Query Builder)</label>
                    <comment>Number of recent messages passed to the fast model (Haiku / Ministral) for query reformulation. Default: 6</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="history_message_max_chars" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>History Message Max. Characters</label>
                    <comment>Maximum number of characters per message in the LLM history. If exceeded, the first and last halves are kept. Applies to all channels (e-mail, WebChat, WhatsApp). Default: 2000</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>

            <!-- Anthropic Claude -->
            <group id="anthropic" translate="label" sortOrder="45" showInDefault="1" showInWebsite="1">
                <label>Anthropic Claude</label>
                <field id="api_key" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1">
                    <label>Main Model</label>
                    <source_model>Zwernemann\Chat\Model\Config\Source\AnthropicModel</source_model>
                    <comment>Sonnet 4.6 recommended – approx. 5x cheaper than Opus 4.7 with comparable quality for B2B order assistance.</comment>
                </field>
                <field id="max_tokens" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1">
                    <label>Max Tokens</label>
                </field>
                <field id="fast_model" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1">
                    <label>Fast Model (Query Reformulation)</label>
                    <source_model>Zwernemann\Chat\Model\Config\Source\AnthropicModel</source_model>
                    <comment>Used for the low-cost conversational query reformulation. Default: Haiku 4.5.</comment>
                </field>
            </group>


            <!-- Voyage AI -->
            <group id="voyage" translate="label" sortOrder="50" showInDefault="1">
                <label>Voyage AI (Embeddings)</label>
                <field id="api_key" translate="label" type="obscure" sortOrder="10" showInDefault="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="model" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Model</label>
                    <comment>e.g. voyage-3</comment>
                </field>
                <field id="catalog_language" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Catalog Language</label>
                    <comment>Language your product catalog is stored in (e.g. "English", "German"). When set, the term extractor also generates synonyms/translations in this language for customer queries written in another language. Leave empty (default) to keep search terms in the customer's own language — recommended when customers and catalog share the same language.</comment>
                </field>
            </group>

            <!-- Pinecone -->
            <group id="pinecone" translate="label" sortOrder="60" showInDefault="1">
                <label>Pinecone (Vector DB)</label>
                <field id="api_key" translate="label" type="obscure" sortOrder="10" showInDefault="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="index_name" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Index Name</label>
                    <comment>e.g. magento-products</comment>
                </field>
                <field id="region" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Region</label>
                    <comment>e.g. us-east-1</comment>
                </field>
                <field id="top_k" translate="label" type="text" sortOrder="40" showInDefault="1">
                    <label>Top K Results</label>
                </field>
            </group>

            <!-- Product Indexer -->
            <group id="product_index" translate="label" sortOrder="62" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Search / Indexing</label>
                <field id="excluded_attributes" translate="label comment" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Excluded Attributes</label>
                    <comment>Comma-separated list of attribute codes that will NOT be included in the Pinecone index (embed text and metadata). Enter sensitive fields such as purchase prices or internal notes here. After a change a full re-index is required (bin/magento cc:index:products --force).</comment>
                </field>
            </group>

            <!-- Payment & Shipping -->
            <group id="payment" translate="label" sortOrder="65" showInDefault="1" showInWebsite="1">
                <label>Payment &amp; Shipping</label>
                <field id="method" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Payment Method Code</label>
                    <comment>Magento payment method code used when placing orders. Examples: checkmo, purchaseorder, free. Default: checkmo.</comment>
                </field>
                <field id="po_number_mode" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1">
                    <label>PO Number Mode</label>
                    <source_model>Zwernemann\Chat\Model\Config\Source\PoNumberMode</source_model>
                    <comment>Only relevant when payment method is "purchaseorder". With "ask_customer" the assistant will request a PO number before placing the order. With "auto_generate" a reference number is created automatically.</comment>
                </field>
                <field id="shipping_method" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1">
                    <label>Preferred Shipping Method</label>
                    <comment>Carrier code and method code joined by underscore, e.g. flatrate_flatrate or freeshipping_freeshipping. Leave empty to use the first available method.</comment>
                </field>
            </group>

            <!-- Magento REST API -->
            <group id="magento_api" translate="label" sortOrder="70" showInDefault="1">
                <label>Magento REST API</label>
                <field id="base_url" translate="label" type="text" sortOrder="10" showInDefault="1">
                    <label>Base URL</label>
                    <comment>Leave empty to use this instance. e.g. https://work.maz.de</comment>
                </field>
                <field id="admin_token" translate="label" type="obscure" sortOrder="20" showInDefault="1">
                    <label>Admin Integration Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>
            <!-- Web Chat Widget -->
            <group id="webchat" translate="label" sortOrder="85" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Web Chat Widget</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Web Chat Widget</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Shows an AI-powered chat widget on the storefront for logged-in customers. Uses the same pipeline as email and WhatsApp.</comment>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Widget Title</label>
                    <comment>Displayed in the chat header. e.g. "Chat with us" or "Order Assistant"</comment>
                </field>
                <field id="button_label" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Chat Button Label</label>
                    <comment>Text on the floating action button. e.g. "Chat" or "Order now"</comment>
                </field>
                <field id="welcome_message" translate="label" type="textarea" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Welcome Message</label>
                    <comment>First message shown when the chat opens.</comment>
                </field>
                <field id="primary_color" translate="label" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Primary Color</label>
                    <comment>Hex color code for the chat header, button and accents. e.g. #1a73e8</comment>
                </field>
                <field id="debug_llm" translate="label" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>LLM Debug Output (WebChat)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, every LLM request payload and full response is shown as a formatted debug block in the WebChat window. Disable in production.</comment>
                </field>
            </group>

            <!-- Escalation & Monitoring -->

            <!-- Systemfehler-Benachrichtigungen -->

            <!-- Allowed Actions (Tool Permissions) -->
            <group id="tools" translate="label" sortOrder="75" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Allowed Actions (Tool Permissions)</label>
                <comment>Disabled tools are not offered to the AI assistant at all. The redirect_to_store tool is always active and cannot be disabled.</comment>

                <!-- Orders -->
                <field id="cart_add_item" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Add item to cart (cart_add_item)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cart_update_item" translate="label" type="select" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Change cart quantity (cart_update_item)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cart_remove_item" translate="label" type="select" sortOrder="12" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Remove item from cart (cart_remove_item)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cart_checkout" translate="label" type="select" sortOrder="13" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Place order / checkout cart (cart_checkout)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="reorder_from_history" translate="label" type="select" sortOrder="14" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Reorder from order history (reorder_from_history)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="get_order_history" translate="label" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Query order history (get_order_history)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="get_order_detail" translate="label" type="select" sortOrder="16" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Query order details (get_order_detail)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="get_shipment_tracking" translate="label" type="select" sortOrder="17" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Query shipment tracking (get_shipment_tracking)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="get_invoice" translate="label" type="select" sortOrder="18" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Retrieve invoice (get_invoice)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <!-- Addresses -->
                <field id="get_shipping_addresses" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show shipping addresses (get_shipping_addresses)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="add_shipping_address" translate="label" type="select" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Add new shipping address (add_shipping_address)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="set_order_shipping_address" translate="label" type="select" sortOrder="22" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Change an order's shipping address (set_order_shipping_address)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <!-- Coupons -->
                <field id="apply_coupon_code" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Apply coupon code (apply_coupon_code)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="remove_coupon_code" translate="label" type="select" sortOrder="31" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Remove coupon code (remove_coupon_code)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <!-- Wishlist -->
                <field id="get_wishlist" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show wishlist (get_wishlist)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="wishlist_add_item" translate="label" type="select" sortOrder="41" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Add product to wishlist (wishlist_add_item)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="wishlist_remove_item" translate="label" type="select" sortOrder="42" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Remove product from wishlist (wishlist_remove_item)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="wishlist_move_to_cart" translate="label" type="select" sortOrder="43" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Move wishlist item to cart (wishlist_move_to_cart)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <!-- Account -->
                <field id="get_account_info" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show account data (get_account_info)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="update_account_info" translate="label" type="select" sortOrder="51" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Change account data (update_account_info)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="toggle_newsletter" translate="label" type="select" sortOrder="52" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Subscribe / unsubscribe newsletter (toggle_newsletter)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <!-- Products -->
                <field id="search_products_by_filter" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Search products by filter (search_products_by_filter)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="set_stock_notification" translate="label" type="select" sortOrder="61" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable stock notification (set_stock_notification)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <!-- WhatsApp Connector -->
        </section>
    </system>
</config>
