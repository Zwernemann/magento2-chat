<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <zwernemann_chat>
            <general>
                <enabled>1</enabled>
            </general>
            <llm>
                <provider>anthropic</provider>
                <system_prompt_additions></system_prompt_additions>
                <address_form>formal</address_form>
                <shop_name></shop_name>
                <history_turns_main>4</history_turns_main>
                <history_turns_account>2</history_turns_account>
                <history_turns_query>6</history_turns_query>
                <history_message_max_chars>2000</history_message_max_chars>
            </llm>
            <anthropic>
                <api_key></api_key>
                <model>claude-sonnet-4-6</model>
                <max_tokens>8192</max_tokens>
                <fast_model>claude-haiku-4-5-20251001</fast_model>
            </anthropic>
            <voyage>
                <api_key></api_key>
                <model>voyage-3</model>
                <catalog_language></catalog_language>
            </voyage>
            <product_index>
                <excluded_attributes>cost,cost_price,purchase_price,margin,supplier_id,internal_notes,bb_comments,bb_email,bb_contact_name</excluded_attributes>
            </product_index>
            <pinecone>
                <api_key></api_key>
                <index_name>magento-products</index_name>
                <region>us-east-1</region>
                <top_k>25</top_k>
            </pinecone>
            <tools>
                <!-- All actions enabled by default so the assistant is fully capable
                     out of the box. Disable individual tools to restrict it. -->
                <get_order_history>1</get_order_history>
                <get_order_detail>1</get_order_detail>
                <get_shipment_tracking>1</get_shipment_tracking>
                <get_invoice>1</get_invoice>
                <get_shipping_addresses>1</get_shipping_addresses>
                <get_wishlist>1</get_wishlist>
                <get_account_info>1</get_account_info>
                <search_products_by_filter>1</search_products_by_filter>
                <cart_add_item>1</cart_add_item>
                <cart_update_item>1</cart_update_item>
                <cart_remove_item>1</cart_remove_item>
                <cart_checkout>1</cart_checkout>
                <reorder_from_history>1</reorder_from_history>
                <add_shipping_address>1</add_shipping_address>
                <set_order_shipping_address>1</set_order_shipping_address>
                <apply_coupon_code>1</apply_coupon_code>
                <remove_coupon_code>1</remove_coupon_code>
                <wishlist_add_item>1</wishlist_add_item>
                <wishlist_remove_item>1</wishlist_remove_item>
                <wishlist_move_to_cart>1</wishlist_move_to_cart>
                <update_account_info>1</update_account_info>
                <toggle_newsletter>1</toggle_newsletter>
                <set_stock_notification>1</set_stock_notification>
            </tools>
            <payment>
                <method>checkmo</method>
                <po_number_mode>none</po_number_mode>
                <shipping_method></shipping_method>
            </payment>
            <magento_api>
                <base_url></base_url>
                <admin_token></admin_token>
            </magento_api>
            <webchat>
                <enabled>1</enabled>
                <title>Chat with us</title>
                <button_label>Chat</button_label>
                <welcome_message>Hello! I am your AI ordering assistant. How can I help you today?</welcome_message>
                <primary_color>#1a73e8</primary_color>
                <debug_llm>0</debug_llm>
            </webchat>
        </zwernemann_chat>
    </default>
</config>
